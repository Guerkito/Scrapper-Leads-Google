# Evolution API (WhatsApp)
EVO_URL=http://localhost:8090
EVO_API_KEY=
EVO_INSTANCE=onyxbot

# Webhook
WEBHOOK_PORT=5001
# Token compartido para autenticar requests al webhook. Configura el mismo
# valor en Evolution API (header `Authorization: Bearer <token>`,
# `X-Webhook-Token`, o `apikey`). Si lo dejas vacío, el webhook arranca sin
# auth (modo dev) y emite un WARNING.
WEBHOOK_AUTH_TOKEN=
# Tamaño máximo del body POST en bytes (defensa básica anti-abuso).
WEBHOOK_MAX_BODY=65536
WEBHOOK_WORKERS=4
WEBHOOK_LLM_BACKEND=ollama

# Ollama local: el webhook no entrega herramientas al texto entrante.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b

# Base de datos
DB_PATH=data/leads.db

# Concurrencia del scraper
MAX_CONCURRENT=6

# Email Marketing (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-password-de-aplicacion
EMAIL_FROM_NAME=Onyx Lead Gen

# Postgres (solo si usas docker-compose con Evolution)
POSTGRES_PASSWORD=
