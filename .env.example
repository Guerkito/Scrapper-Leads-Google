# Evolution API (WhatsApp)
EVO_URL=http://localhost:8090
EVO_API_KEY=
EVO_INSTANCE=onyxbot

# Webhook
WEBHOOK_PORT=5001
# Token compartido para autenticar requests al webhook. Configura el mismo
# valor en Evolution API (header `Authorization: Bearer <token>`,
# `X-Webhook-Token`, o `apikey`). Si lo dejas vacío, el webhook arranca sin
# auth (modo dev) y emite un WARNING.
WEBHOOK_AUTH_TOKEN=
# Tamaño máximo del body POST en bytes (defensa básica anti-abuso).
WEBHOOK_MAX_BODY=65536
WEBHOOK_WORKERS=4
WEBHOOK_LLM_BACKEND=ollama

# Panel web (FastAPI): vacío = sin login (solo recomendado en localhost).
PANEL_PASSWORD=
# Clave que firma la cookie de sesión; si vacío se deriva de PANEL_PASSWORD.
SESSION_SECRET=
SESSION_DAYS=30
# Tamaño máximo de archivos para importar/restaurar desde el panel (MB).
PANEL_MAX_UPLOAD_MB=20

# Ollama local: el webhook no entrega herramientas al texto entrante.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b

# Base de datos
DB_PATH=data/leads.db

# Concurrencia del scraper
MAX_CONCURRENT=6

# Email Marketing (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-password-de-aplicacion
EMAIL_FROM_NAME=Onyx Lead Gen

# Link de agenda (Cal.com, Calendly, etc.) para el bot y los correos
CALCOM_LINK=

# Confirmación automática de reuniones con la API de Cal.com
# (créala en Cal.com → Settings → Developer → API keys, empieza con cal_)
CALCOM_API_KEY=
CALCOM_API_VERSION=2026-05-01
MEETINGS_POLL_MINUTES=30
MEETINGS_BATCH=25

# Bandeja de entrada (IMAP): responde a las respuestas de los prospectos.
# Si no defines IMAP_*, se reutilizan EMAIL_USER / EMAIL_PASS.
# En Gmail activa IMAP y usa una contraseña de aplicación.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
INBOX_POLL_SECONDS=60

# Follow-ups automáticos (0 en FOLLOW_UP_MAX los desactiva)
FOLLOW_UP_MAX=2
FOLLOW_UP_DAYS=3
FOLLOW_UP_POLL_MINUTES=60

# Envío gestionado: "smtp" (por defecto) o "resend" (API, requiere dominio verificado)
SENDER_PROVIDER=smtp
RESEND_API_KEY=
SENDER_FROM_EMAIL=
# Pausa los envíos al superar este número por día (0 = sin límite)
SENDER_DAILY_LIMIT=0
# Coste estimado por email para el panel de rendimiento (ej. 0.001)
COST_PER_EMAIL=0

# Optimización automática: pausa segmentos sin respuesta tras N leads contactados
AUTO_OPTIMIZE=true
OPTIMIZE_MIN_LEADS=25
OPTIMIZE_SCALE_RATE=0.08

# Postgres (solo si usas docker-compose con Evolution)
POSTGRES_PASSWORD=
